@using Westwind.AspNetCore.Components
@model PostHitsViewModel

@{
	ViewData["Title"] = "Post Hits";
}

<div class="posthits-page" style="font-size: 0.8em">
	<div class="posthits-header card mb-4">
		<div class="card-body">
			<div class="posthits-header-top">
				<div>
					<h1 class="page-header-text mb-2 mt-0">
						<i class="fad fa-chart-line"></i>
						Post Hits
					</h1>
					<div class="byline mb-0">
						Traffic snapshot for the last few days with quick cleanup for stale hit log entries.
					</div>
				</div>

				<div class="posthits-actions">
					<a asp-action="Index" class="btn btn-outline-secondary">
						<i class="fa fa-arrow-left"></i>
						Back to Admin
					</a>
					<a asp-action="DeleteOldPostHits"
					   class="btn btn-outline-danger"
					   onclick="return confirm('Delete post hit entries older than 7 days?');">
						<i class="fa fa-trash"></i>
						Delete Older Than 7 Days
					</a>
				</div>
			</div>
		</div>
	</div>

	<error-display class="mt-3 mb-4" error-display-model="@Model.ErrorDisplay">
	</error-display>

	<section class="card mb-4 posthits-card" >
		<div class="card-header">
			<span>
			<i class="fad fa-table-list"></i>
			Summary of Top Requests
			</span>
			<span class="posthits-section-count">
				
			</span>
		</div>
		<div class="card-body p-0">
			<div class="table-responsive posthits-table-wrap">
				<table class="table table-hover posthits-table posthits-summary-table mb-0">
					<thead>
					<tr>
						<th scope="col">Period</th>
						<th scope="col">Total Hits</th>						
						<th scope="col">Top Post</th>						
					</tr>
					</thead>
					<tbody>

					@foreach (var row in Model.SummaryRows)
					{
						<tr>
							<td data-label="Period">
								<span class="posthits-period">@row.Label</span>
							</td>
							<td data-label="Total Hits">
								<span class="posthits-number">@row.TotalHits</span>
							</td>
							@* <td data-label="Tracked Urls">@row.UrlCount</td> *@
							<td data-label="Top Post">
									@{
										var hitList = row.Hits.Take(3).ToList();
									}
								<small>
								@for(int i = 0; i < hitList.Count; i++)
								{
									var hit = hitList[i];
									<a href="@hit.Url"  class="d-block" style="border-bottom: 1px #555 solid; padding-bottom: 0.2em"
									   target="_blank" rel="noopener noreferrer">
											@(i + 1). @hit.Title  <small><i> &bull; @hit.Hits hits</i></small>
									</a>
								}
								</small>
							</td>							
						</tr>
					}
					</tbody>
				</table>
			</div>
		</div>
	</section>
	

	@foreach (var sec in Model.DailySections)
	{
		<section class="card mb-4 posthits-card">
			<div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
				<span>
					<i class="fad fa-calendar-day"></i>
					@sec.Label
				</span>
				<span class="posthits-section-count">
					@* @sec.Hits.Sum(hit => hit.Hits) total hits *@
				</span>
			</div>
			<div class="card-body p-0">
				@if (sec.Hits.Count == 0)
				{
					<div class="p-4 text-muted">No hits were recorded for this day.</div>
				}
				else
				{
					<div class="table-responsive posthits-table-wrap">
						<table class="table table-hover posthits-table mb-0">
							<thead>
							<tr>
								<th scope="col">Url</th>
								<th scope="col" class="posthits-hits-column">Hits</th>
							</tr>
							</thead>
							<tbody>
							@foreach (var hit in sec.Hits)
							{
								<tr>
									<td data-label="Url">
										<a href="@hit.Url" target="_blank" rel="noopener noreferrer" class="posthits-link">
												@hit.Title
										</a>										
									</td>
									<td data-label="Hits" class="posthits-hits-column">
										<span class="posthits-badge">@hit.Hits</span>
									</td>
								</tr>
							}
							</tbody>
						</table>
					</div>
				}
			</div>
		</section>
	}
</div>

@section headers {
	<style>
		.posthits-page {
			margin-top: 1rem;
		}

		.posthits-header,
		.posthits-card {
			background: var(--surface);
			border: 1px solid var(--border);
			box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
		}

		.posthits-header-top {
			display: flex;
			gap: 1.5rem;
			justify-content: space-between;
			align-items: flex-start;
			flex-wrap: wrap;
		}

		.posthits-actions {
			display: flex;
			gap: 0.75rem;
			flex-wrap: wrap;
		}

			.posthits-actions .btn {
				white-space: nowrap;
			}

		.posthits-card .card-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
			font-weight: 600;
		}

		.posthits-section-count {
			font-size: 0.9rem;
			color: var(--text-muted);
		}

		.posthits-table-wrap {
			overflow-x: auto;
		}

		.posthits-table {
			width: 100%;
			margin-bottom: 0;
		}

			.posthits-table thead th {
				background: var(--surface2);
				color: var(--text);
				border-bottom: 1px solid var(--border);
				font-weight: 600;
				white-space: nowrap;
			}

			.posthits-table tbody td {
				vertical-align: top;
				border-color: var(--border);
				padding: 0.2rem 1rem;
			}

			.posthits-table tbody tr:nth-child(even) {
				background: color-mix(in srgb, var(--surface2) 75%, transparent);
			}

		.posthits-period {
			font-weight: 600;
		}

		.posthits-number {
			font-size: 1.1rem;
			font-weight: 700;
			color: var(--heading-color);
		}

		.posthits-link {
			color: var(--link);
			font-weight: 600;
			max-width: 600px;
			overflow-wrap: anywhere;
		}

			.posthits-link:hover {
				color: var(--link-hover);
			}

		.posthits-title {
			margin-top: 0.35rem;
			color: var(--text-muted); 
			overflow-wrap: anywhere !important;
			font-size: 0.92rem;
		}

		.referrers-table td:nth-child(1),
		.referrers-table td:nth-child(2) {
			min-width: 280px;
		}

		.posthits-hits-column {
			width: 120px;
			text-align: right;
			white-space: nowrap;
		}

		.posthits-badge {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-width: 3.25rem;
			padding: 0.3rem 0.7rem;
			border-radius: 999px;
			background: color-mix(in srgb, var(--accent) 18%, transparent);
			color: var(--heading-color);
			font-weight: 700;
		}

		@@media (max-width: 767.98px) {
			.posthits-actions {
				width: 100%;
				flex-direction: column;
			}

				.posthits-actions .btn {
					width: 100%;
				}

			.posthits-table thead {
				display: none;
			}

			.posthits-table,
			.posthits-table tbody,
			.posthits-table tr,
			.posthits-table td {
				display: block;
				width: 100%;
			}

				.posthits-table tbody tr {
					padding: 0.85rem 1rem;
					border-bottom: 1px solid var(--border);
				}

				.posthits-table tbody td {
					padding: 0.35rem 0;
					border: 0;
				}

					.posthits-table tbody td::before {
						content: attr(data-label);
						display: block;
						margin-bottom: 0.15rem;
						color: var(--text-muted);
						font-size: 0.82rem;
						font-weight: 600;
						text-transform: uppercase;
						letter-spacing: 0.03em;
					}

			.posthits-hits-column {
				width: auto;
				text-align: left;
			}
		}

	</style>
}