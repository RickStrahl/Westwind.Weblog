@model Westwind.Weblog.PostViewModel
@{
    var config = Model.PostRepo.Configuration;
    ViewData["Title"] = config.ApplicationName;

    
    var appUser = User.GetAppUser();
    bool isAdmin = appUser?.IsAdmin ?? false;

    var posts = Model.Posts;
    var repo = Model.PostRepo;
}



<div class="post-search-container" style="margin: 0 1em 1em 1em; position: relative;">
  
	<div class="input-group small" style="max-width: 100%; margin-top: -0.55em;">
		<span class="input-group-text" style="background: var(--input-bg); border-color: var(--border); color: var(--text-muted);">
			<i class="fas fa-search" style="font-size: 0.85em;"></i>
		</span>
		<input type="text" id="PostSearchInput"
		       class="form-control form-control-sm"
		       placeholder="Search weblog posts..."
		       autocomplete="off"
		       style="background: var(--input-bg); color: var(--input-color); border-color: var(--border);" />
		<button type="button" class="btn btn-outline-secondary btn-sm" id="PostSearchClear"
		        style="display:none; border-color: var(--border); color: var(--text-muted);">
			<i class="fas fa-times" style="font-size: 0.8em;"></i>
		</button>
	</div>

    <div id="PostSearchDropdown" style="
        display: none;
        position: absolute;
        top: calc(100% + 3px);
        left: 0;
        width: 480px;
        max-width: 95vw;
        max-height: 400px;
        overflow-y: auto;
        background: var(--surface);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 4px;
        box-shadow: 0 4px 14px rgba(0,0,0,.25);
        z-index: 1000;">
    </div>
</div>

<div style="margin: 0 1em 1em 1em;">
    @{
        int counter = 0;
        foreach (var post in posts)
        {
            counter++;

            if (!post.Active)
			{
				continue;
			}   

            if (post.IsFeatured)
            {
                                <img src="~/images/featured.png" style="float: left; margin-right: 5px;"/>
            }

                   <div class="post-item-wrapper" id="@post.Id">

                            <h2 class="page-header mb-1">                
                                <a href="@post.GetPostUrl()"
                                        style="text-decoration: none;">@post.Title</a>
                            </h2>
                            

                            <div class="float-end">
                                
                                @if (post.CommentCount > 0)
                {
                                    <a href="@(repo.GetPostUrl(post))#Comments">
                                        <i class="fad fa-comments-alt" ></i>
                                        @repo.ShowCommentCount(post)
                                    </a>

                }
                            </div>


                            <div class="byline">
                                <i class="far fa-clock-rotate-left text-info"></i>
                                @AppWebUtils.WebLogDateString(post.Created,false )
                                @(string.IsNullOrEmpty(post.Location) ? "" : "- " + post.Location)
                            </div>

                            

                            @if (counter < 15 && !string.IsNullOrEmpty((string)post.FeaturedImageUrl))
            {
                                <div class="featured-image-wrapper mt-2 mb-1">
                                    <img class="featured-image" src="@post.FeaturedImageUrl" loading="lazy" />
                                </div>
            }            

                            <div class="postcontent mt-0" style="margin-bottom: 20px">
                                @post.Abstract.TrimEnd()  
                                
                                <p class="margin-top margin-bottom">
                                    <a href="@repo.GetPostUrl(post)">Read more...</a>
                                </p>
                            </div>

                   </div>
        }
    }
</div>


@section headers {
    <link rel="canonical" href="<%= App.Configuration.WebLogHomeUrl.TrimEnd('/') %>" />

    <meta id="metaKeyWords" name="Keywords" content="DotNet,.Net,C#,ASP.NET,JavScript,Angular,jQuery,Rick Strahl,HTML,CSS,West Wind Technologies,WebLog,Blog" runat="server" />
    <meta id="metaDescription" name="Description" content="Rick Strahl's Weblog - Wind, Waves, Code and everything in between..." runat="server" />


    
    <meta property="og:title" content="Rick Strahl's Weblog" />
    <meta property="og:description" content="Wind, Waves, Code and everything in between..." />    
    <meta property="og:type" content="article" />
    <meta property="article:author" content="https://facebook.com/rickstrahl" />
    <meta property="og:url" content="https://weblog.west-wind.com" />
    <meta property="og:image" content="https://weblog.west-wind.com/images/HeroImages/RickHero13.jpg"/>

    <meta name="twitter:card" content="summary" />
    <link href="~/css/postlist.css" rel="stylesheet" />
}


@section scripts {
	<script src="~/scripts/post.js"></script>
    
}