<br />

@if (post.Comments.Count > 0) 
{ 
<h2 id="Comments">The Voices of Reason</h2>
<hr style="margin-bottom: 30px;" />


    <div class="clearfix"></div>


    foreach (var comment in post.Comments)
    {
         if(!comment.IsActive && !isAdmin)
         {
                continue;
         }   

         
         <div id="@comment.Id" class="comment @(comment.IsActive ? "" : "inactive")">

             <div class="comment-panel-left">
                 @AppWebUtils.GravatarLink(comment)

                 <div>
                     @if (string.IsNullOrEmpty(comment.Url))
                     {
                         <div style="font-size: 0.85em">@comment.Author</div>
                     }
                     else
                     {
                         <div style="font-size: 0.85em">
                             <a href="@comment.Url" target="_WebLog">@comment.Author</a>
                         </div>
                     }
                     <small style="font-style: italic; font-size: 0.7em">
                        <i class="far fa-clock"></i>
                         @AppWebUtils.WebLogDateString(comment.Created, false)
                     </small>
                 </div>
             </div>

             <div class="comment-panel-right">
                 <h3 style="margin-top: 0; font-size: 1.2em; margin-bottom: 0">
                     <a name="@comment.Id" href="#@comment.Id">#</a>
                     @comment.Title
                 </h3>
                 <div class="commentbody" style="padding-top: 0.7em;">                     
                     @(comment.BodyMode == 2 ? Html.Raw(Markdown.Parse(comment.Body?.Trim())) : Html.Raw(comment.Body?.Trim()))
                 </div>

                 @if (isAdmin)
                 {
                     <div style="margin-top: 10px;">
                         <a href='javascript:{}' data-id="@post.Id"
                            class="hoverbutton remove-comment">
                             <i class="fa fa-close red-color"></i>
                             Remove Comment
                         </a>
                         <asp:Image runat="server" ImageUrl="~/images/EditWhite.gif" 
                                    class="hoverbutton commentedit"/>
                     </div>
                 }
             </div>
         </div>
         <div class="clearfix"></div>
     }
        
 }
    

@if(Model.ActiveComment.IsCommentDialogVisible) {
    <partial name="Comment_Partial" model="Model" />
}
else {    
    <form action="@(Request.Path)#Comments" method="post">
        <input type="hidden" name="force" value="1" />
        <button class="btn btn-primary" id="CommentSubmit"
                type="submit"
                style="font-weight: bold; padding: 10px 30px;">
            <i class="fa fa-comments-o"></i>&nbsp;
            Add a Comment
        </button>

    </form>
}

@{
    var commentErrorModel = new ErrorDisplayModel()
    {
        Message = null,
        Icon = Model.ActiveComment.CommentErrorIcon
    };
}
<error-display error-display-model="commentErrorModel"></error-display>

<br />

</article>

@section scripts {
    <link href="~/scripts/highlightjs/styles/vs2015.css" rel="stylesheet" />
    <script src="~/scripts/highlightjs/highlight.pack.js"></script>
    <script>
        $('pre code').each(function (i, block) {
            hljs.highlightBlock(block);
        });
    </script>
}
