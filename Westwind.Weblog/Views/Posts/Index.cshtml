@model Westwind.Weblog.PostViewModel
@{
    var config = Model.PostRepo.Configuration;
    ViewData["Title"] = config.ApplicationName;
    var posts = Model.Posts;
    var repo = Model.PostRepo;
}

<div style="margin: 0 1em 1em 1em; ">
    @{
        int counter = 0;
        foreach (var post in posts)
        {
            counter++;

            if (post.IsFeatured)
            {
                <img src="~/images/featured.png" style="float: left; margin-right: 5px;"/>
            }
            <h2 class="margin-top">                
                <a href="@Model.PostRepo.GetPostUrl(post.SafeTitle, post.Created)"
                        style="text-decoration: none;">@post.Title</a>
            </h2>
            <hr/>
            

            <div class="float-end">
                
                @if (post.CommentCount > 0)
                {
                    <a href="@(repo.GetPostUrl(post))#Feedback">
                        <i class="fa fa-comments-o"></i>
                        @repo.ShowCommentCount(post)
                    </a>
                }
            </div>


            <div class="byline">
                <i class="far fa-clock-rotate-left text-info"></i>
                @AppWebUtils.WebLogDateString(post.Created,false )
                @(string.IsNullOrEmpty(post.Location) ? "" : "- " + post.Location)
            </div>


            @if (counter < 15 && !string.IsNullOrEmpty((string)post.ImageUrl))
            {
                <div class="featured-image-wrapper">
                    <img class="featured-image" src="@post.ImageUrl" loading="lazy" />
                </div>
            }


            <div class="postcontent" style="margin-bottom: 20px">
                @post.Abstract.TrimEnd()  
                
                <p class="margin-top margin-bottom">
                    <a href="@repo.GetPostUrl(post)">Read more...</a>
                </p>
            </div>
        }
    }
</div>


@section Headers {
    <link rel="canonical" href="<%= App.Configuration.WebLogHomeUrl.TrimEnd('/') %>" />

    <meta id="metaKeyWords" name="Keywords" content="DotNet,.Net,C#,ASP.NET,JavScript,Angular,jQuery,Rick Strahl,HTML,CSS,West Wind Technologies,WebLog,Blog" runat="server" />
    <meta id="metaDescription" name="Description" content="Rick Strahl's Weblog - Wind, Waves, Code and everything in between..." runat="server" />


    
    <meta property="og:title" content="Rick Strahl's Weblog" />
    <meta property="og:description" content="Wind, Waves, Code and everything in between..." />    
    <meta property="og:type" content="article" />
    <meta property="article:author" content="https://facebook.com/rickstrahl" />
    <meta property="og:url" content="https://weblog.west-wind.com" />
    <meta property="og:image" content="https://weblog.west-wind.com/images/HeroImages/RickHero13.jpg"/>

    <meta name="twitter:card" content="summary" />

    
    <style>
        .featured-image {
            margin-top: 0.5em;
            max-width: 600px;
        }
        .featured-image-wrapper {
            max-height: 300px; 
            overflow: hidden;
        }
       @@media(max-width: 600px) {
        .featured-image {
            max-width: 100%;
        }
        .featured-image-wrapper {
            max-height: 240px; 
        }
        }
        </style>
}