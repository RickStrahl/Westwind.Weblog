<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Version>0.1.4</Version>
		<UserSecretsId>826df5fe-bc20-4b17-9e36-39ccd496c1aa</UserSecretsId>
		<MvcRazorCompileOnPublish>true</MvcRazorCompileOnPublish>
	</PropertyGroup>


	<ItemGroup>
	  <Content Remove="wwwroot\admin\ads.xml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.11" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.11" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Westwind.AspNetCore" Version="4.1.11" />
		<PackageReference Include="Westwind.AspNetCore.LiveReload" Version="0.7.1" />
		<PackageReference Include="Westwind.AspNetCore.Markdown" Version="3.41.0" />
	</ItemGroup>


	<ItemGroup>
		<!-- Libraries-->
		<!--<ProjectReference Include="..\..\Westwind.AspNetCore.Markdown\Westwind.AspNetCore.Markdown\Westwind.AspNetCore.Markdown.csproj" />-->
		<!--<ProjectReference Include="..\..\Westwind.AspNetCore\Westwind.AspNetCore\Westwind.AspNetCore.csproj" />-->
		<!--<ProjectReference Include="..\..\Westwind.Data.EfCore\Westwind.Data.EfCore\Westwind.Data.EfCore.csproj" />-->	
		<ProjectReference Include="..\BlazePostApi\BlazePostApi.Server\BlazePostApi.Server.csproj" />
		<ProjectReference Include="..\Westwind.Weblog.Business\Westwind.Weblog.Business.csproj" />

		<!-- Application -->
		<!--<ProjectReference Include="..\Westwind.WeblogServices.Client\Westwind.WeblogServices.Client.csproj" />-->
	</ItemGroup>


	<ItemGroup>
		<Content Include="pingo.exe" CopyToOutputDirectory="PreserveNewest" />
		<Content Include=".\_weblog-configuration.json" CopyToOutputDirectory="PreserveNewest" />
		<Content Update="wwwroot\admin\ads.xml">
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		  
		<Content Update=".\_weblog-configuration.json" CopyToPublishDirectory="Never" />

		
		<Content Update="wwwroot\admin\applicationlog.txt" CopyToPublishDirectory="Never" />

		<!-- Ignore Year Image subfolders but publish root folder and Sponsors -->
		<Content Update="wwwroot\images\**\*" CopyToPublishDirectory="Never" />
		
		<!-- root folder and Sponsors get published -->
		<Content Update="wwwroot\images\*.*" CopyToPublishDirectory="PreserveNewest" />
		<Content Update="wwwroot\images\Sponsors\*.*" CopyToPublishDirectory="PreserveNewest" />			
	</ItemGroup>
</Project>
