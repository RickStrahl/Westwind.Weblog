@using Westwind.AspNetCore.Components
@using Westwind.AspNetCore.Markdown

@model PostViewModel

@{
    var post = Model.Post;
    var repo = Model.PostBus;
    var config = wlApp.Configuration;

	ViewBag.Title = post.Title + " - " + config.ApplicationName;

    string postUrl = repo.GetPostUrl(post);

    var appUser = User.GetAppUser();
    bool isAdmin = appUser.IsAdmin;

    var Request = Context.Request;
    var pageUrl = config.WeblogHomeUrl + Request.Path.Value;
}

@section headers
{
    <meta id="metaKeyWords" name="Keywords" content="@post.Keywords" />
    <meta id="metaDescription" name="Description" content="@post.Abstract" />

    <meta property="og:title" content="@post.Title" />
    <meta property="og:description" content="@post.Abstract"/>
    <meta property="og:type" content="article" />
    <meta property="article:author" content="https://x.com/rickstrahl" />
    <meta property="og:url" content="@pageUrl"/>

    <meta name="twitter:site" content="https://weblog.west-wind.com">
    <meta name="twitter:creator" content="@@rickstrahl">

    @if (!string.IsNullOrEmpty(post.FeaturedImageUrl))
    {        
        <meta name="twitter:card" content="summary_large_image" />
        <meta property="og:image" content="@(post.FeaturedImageUrl)"/>
    }
     
    <link href="~/css/post.css" rel="stylesheet" />
}

<article itemscope itemtype="http://schema.org/BlogPosting" itemprop="blogPost">


<header>
	@if(isAdmin)
	{
        <div class="float-end mt-2">
                
	        <span style="font-size: 0.675em">@Model.Post.Id</span>
	        
            <a href="@(config.ApplicationBasePath)admin/posts?postId=@post.Id"
	           title="Edit this post (admin)" target="_blank"
	           style="margin-top: -0.35em; margin-right: 0.2em; font-size: 0.9em; "
	           class="hoverbutton me-0">
		        <i class="fad fa-edit" 
                   style=" --fa-secondary-opacity: 0.7; --fa-secondary-color: darkgoldenrod; --fa-primary-color: #aaa"></i>
	        </a>

            <a href="#none" onclick="deletePost(); return false;" 
		       title="Delete this post (admin)"
		       style="margin-top: -0.35em;margin-right: 0.1em; font-size: 0.9em;"
		       class="hoverbutton me-0">
		    <i class="fad fa-circle-xmark text-danger" 
               style=" --fa-secondary-opacity: 0.7; --fa-primary-color: white"></i>
		    </a>          

        </div>
    
		<script>
			deletePost = function () {
				if (confirm('Are you sure you want to delete this post?')) {
					
					ajaxJson(page.basePath + "posts/@post.Id/delete", null,
						(res) => { 
                            location.href = page.basePath + "posts";
						},
						(err) => {
							alert("Error deleting post: " + err.responseText);
						},
						{ HttpVerb: "GET" });                                                    
				}
			}
		</script>
	}
    <h2 class="page-header mb-1" itemprop="headline_name">
        @post.Title            
    </h2>
</header>
    

<div class="byline">

     <div class="share-box" style="float:right; ">
        <span class="share-label hidable-xs">Share on:</span>
                            
        <a href="https://twitter.com/intent/tweet?url=@pageUrl&amp;text=@Model.Post.Title&amp;via=RickStrahl" target="_blank" title="Tweet on Twitter">
            <span class="fa-stack" style="line-height: 1em;width: 1em; height: 1em;">
                <i class="fa fa-circle fa-stack-1x" style=" color: white; font-size: 0.7em "></i>
                <i class="fab  fa-square-x-twitter fa-square-twitter fa-stack-1x" 
                   style="font-size: 1em; color: black"></i>                
            </span>
        </a>
        <a href="https://www.facebook.com/sharer/sharer.php?u=@pageUrl&amp;t=@Model.Post.Title" 
            target="_blank" title="Share on Facebook">
            <span class="fa-stack" style="line-height: 1em;width: 1em;height: 1em;">
                <i class="fa fa-square fa-stack-1x" style=" color: white; font-size: 0.88em "></i>
                <i class="fab fa-facebook-square fa-stack-1x" style="color: rgb(63, 96, 170); "></i>                
            </span>
        </a>
        
    </div>

    <div class="leftbox">
        <i class="far fa-clock-rotate-left text-info"></i>
        @(AppWebUtils.WebLogDateString(post.Created, false))
            @(string.IsNullOrEmpty(post.Location) ? "" : " • from " + post.Location)
            @if (post.CommentCount > 0) {            
            <span>
	            • <i class="far fa-comment-lines"></i>
	            <a href="@(repo.GetPostUrl(post))#Comments">
                @repo.ShowCommentCount(post)
                </a>
            </span>
            }                
            @if ((post.Hits > 1 && post.Created > new DateTime(2025,1,1)) ||
                 post.Hits > 100 )
            {
	            <span style="color: var(--text-muted); font-size: 0.7em;">
		        • @post.Hits.ToString("n0") views
	            </span>
            }
    </div>
    

</div>

<div class="clearfix"></div>

<div class="mt-2">
    <error-display error-display-model="Model.ErrorDisplay"></error-display>
</div>


<div id="ArticleBody" class="postcontent" itemprop="articleBody">
    @*@if (!string.IsNullOrEmpty(App.SponsoredTopAd)) { 
            <%= App.SponsoredTopAd %>
            }*@



    <div class="document-outline" >
	    <div class="document-outline-header">On this page:</div>
	    
        <div class="document-outline-content">           
	    </div>
            
	    @if (!string.IsNullOrEmpty(@Model.Post.GithubUrl))
	    {
	    <a class="margin-top" href="@Model.Post.GithubUrl" target="_blank" 
	       title="Allows you to contribute to this article on GitHub by issueing a PR to correct or add information. 
No guarantees that changes will be accepted."
	       style="border-left: none;">
		    <i class="fa fa-pencil" ></i> 
		    Edit this Post
	    </a>
	    }
    </div>


    @Html.Raw(Model.PostHtml)


    @if(Model.RelatedPosts != null &&Model.RelatedPosts.Count > 0)
        {
	        <div style="margin: 30px 0">
		        <h3 style="margin-top: 30px">
			        Other Posts you might also like
		        </h3>

		        <ul>
			      @foreach(var related in Model.RelatedPosts)
                    {
                        <li><a href="@related.SafeTitle">@related.Title</a></li>
                    }
		        </ul>
	        </div>
        }

    @*<% if (RelatedPosts != null && RelatedPosts.Rows.Count > 0)
            { %>
            <div style="margin: 30px 0">
                <h3 style="margin-top: 30px">
                    Other Posts you might also like
                </h3>

                <ul>
                    <asp:Repeater runat="server" ID="repRelatedPosts">
                        <ItemTemplate>
                            <li><a href="<%# Entry.GetPostUrl(Eval(" SafeTitle") as string,(DateTime) Eval("Entered")) %>"><%# Eval("Title")  %></a></li>
                        </ItemTemplate>
                    </asp:Repeater>
                </ul>
            </div>
            <% } %>*@
</div>



<div class='borderbox'
     style='margin-top: 20px; min-height:30px;'>
 

	

    <div class="donate-buttons float-end">
            <div class="share-box small">
            <span class="share-label hidable-xs">Share:</span>

            <a href="https://twitter.com/intent/tweet?url=@pageUrl&amp;text=@Model.Post.Title&amp;via=RickStrahl" target="_blank" 
               title="Share Post on X">
                <span class="fa-stack" style="line-height: 1em;width: 1em; height: 1em; margin-top: 0.04em">
                    <i class="fa fa-circle fa-stack-1x" style=" color: white; font-size: 0.7em "></i>
                    <i class="fab fa-square-x-twitter fa-stack-1x" style=" color: black;"></i>
                </span>
            </a>
            <a href="https://www.facebook.com/sharer/sharer.php?u=@pageUrl&amp;t=@Model.Post.Title" 
               target="_blank" title="Share Post on Facebook">
                <span class="fa-stack" style="line-height: 1em;width: 1em; height: 1em;">
                    <i class="fa fa-circle fa-stack-1x" style=" color: white; font-size: 0.85em "></i>
                    <i class="fab fa-square-facebook fa-stack-1x" style=" color: rgb(63, 96, 170); font-size: 1em"></i>
                </span>
            </a>
            
        </div>
    </div>
    
    <div class=small>
	    @AppWebUtils.CategoryLinks(repo)
    </div>

    


        

</div>

<br />

@if (post.Comments.Count > 0) 
{ 
<h2 id="Comments">The Voices of Reason</h2>


        <div class="mt-2 mb-2">
            <error-display error-display-model="Model.ErrorDisplay" dismissible="true"></error-display>
        </div>


<hr style="margin-bottom: 30px;" />


    <div class="clearfix"></div>


    foreach (var comment in post.Comments)
    {
         if(!comment.IsActive && !isAdmin)
         {
                continue;
         }   

         
         <div id="@comment.Id" class="comment @(comment.IsActive ? "" : "inactive")">

             <div class="comment-panel-left">
                 @AppWebUtils.GravatarLink(comment)

                 <div>
                     @if (string.IsNullOrEmpty(comment.Url))
                     {
                         <div style="font-size: 0.85em">@comment.Author</div>
                     }
                     else
                     {
                         <div style="font-size: 0.85em">
                             <a href="@comment.Url" target="_WebLog">@comment.Author</a>
                         </div>
                     }
                     <small style="font-style: italic; font-size: 0.7em">
                        <i class="far fa-clock"></i>
                         @AppWebUtils.WebLogDateString(comment.Created, false)
                     </small>
                 </div>
             </div>

             <div class="comment-panel-right">
                 <h3 style="margin-top: 0; font-size: 1.2em; margin-bottom: 0">
                     <a name="@comment.Id" href="#@comment.Id">#</a>
                     @comment.Title
                 </h3>
                 <div class="commentbody" style="padding-top: 0.7em;">                     
                     @(comment.BodyMode == 2 ? Html.Raw(Markdown.Parse(comment.Body?.Trim())) : Html.Raw(comment.Body?.Trim()))
                 </div>

                 @if (isAdmin)
                 {
                     <div style="margin-top: 10px;">
                                              
                         @if(!comment.IsActive)    {
	                         <a href='#none' data-id="@comment.Id"
	                            class="hoverbutton approve-comment">
		                         <i class="fa fa-circle-check text-success"></i>
		                         Approve Comment
	                         </a>
	                      
                         }
                         <a href='#none' data-id="@comment.Id"
                            class="hoverbutton remove-comment">
	                         <i class="fa fa-circle-xmark text-danger"></i>
	                         Remove Comment
                         </a>
                        
                     </div>
                     

                 }
             </div>
         </div>
         <div class="clearfix"></div>
     }
        
 }
    

    @if (!post.CommentsClosed)
    {
        if (Model.ActiveComment.IsCommentDialogVisible)
        {
            <div id="CommentBox">
                <partial name="Comment_Partial" model="Model" />
            </div>
        }
        else
        {
            <form action="@Url.Content("~" + Request.Path)#CommentBox" method="post">
                <input type="hidden" name="force" value="1" />
                <button class="btn btn-primary" id="CommentSubmit"
                type="submit"
                style="font-weight: bold; padding: 10px 30px;">
                    <i class="fad fa-comments"></i>&nbsp;
                    Add a Comment
                </button>

            </form>
        }
    }

<br />

</article>

@section scripts {
	<script src="~/scripts/post.js" ></script>
    <link href="~/scripts/highlightjs/styles/vs2015.css" rel="stylesheet" />
    <script src="~/scripts/highlightjs/highlight.pack.js"></script>
    <script>
        $('pre code').each(function (i, block) {
            hljs.highlightBlock(block);
        });
    </script>

	@if (isAdmin)
    {
        <script>
            handleCommentClicks();
        </script>
    }
}
