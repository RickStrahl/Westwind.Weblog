@using System.Globalization
@using System.Runtime.InteropServices
@using Westwind.AspNetCore.Components

@model AdminViewModel

@inject WeblogConfiguration Config

@{
    ViewData["Title"] = "Weblog Administration";
    var user = User.GetAppUser();
    var isAdmin = user.IsAdmin;
	this.Layout = "_Layout";
}

<h1 class="page-header-text mb-0">
    <i class="fad fa-cogs"></i>
    Weblog Administration
</h1>

<div class="mt-1 mb-3 byline">
    v@(Model.ApplicationVersion) &nbsp;<small style="font-size: 0.75em">(@Model.ApplicationDate)</small> &bull;
    @wlApp.EnvironmentName &bull;
    @RuntimeInformation.FrameworkDescription &bull; @RuntimeInformation.OSArchitecture
</div>

<error-display class="mt-3 mb-4" error-display-model="@Model.ErrorDisplay">
</error-display>

<div class="responsive-container">

    <div class="card w-50 me-2">
        <div class="card-header"  >
            <i class="far  fa-ruler fa-fw"></i>
            Weblog Operations
        </div>
		<div class="list-group list-group-flush">
			<a class="list-group-item list-group-item-action "
			   asp-action="UpdateCommentCounts">Update Comment Counts</a>
			<a asp-action="DeleteUnusedImages" class="list-group-item list-group-item-action">Delete Unused Images</a>
			<a asp-action="PostHits" class="list-group-item list-group-item-action">Post Hits Dashboard</a>
			<a class="list-group-item list-group-item-action"
			   asp-action="Ads">Manage Ads</a>


		</div>
    </div>

    <div class="card w-50 me-2">
        <div class=" card-header">
            <i class="fad fa-gears fa-fw"></i>
            System Administration
        </div>
        <div class="list-group list-group-flush">
			@* <a href="/admin/import" class="list-group-item list-group-item-action">Import from Old Weblog</a> *@
            <a href="/admin/applicationlog.txt" class="list-group-item list-group-item-action">Show Error Log</a>
            <a href="/admin/cleanupdatabase" class="list-group-item list-group-item-action">Cleanup and Shrink Database</a>
            <a class="list-group-item list-group-item-action"
               asp-action="Backup">Backup Database</a>

        </div>

    </div>

</div>

<div class="mt-3">
    <h3 class="page-header-text">
        <i class="fad fa-gear"></i>
        Additional Application Info
    </h3>

    <div class="byline mb-2">
        os: @RuntimeInformation.OSDescription &bull;
        user: @System.Environment.UserName &bull;
        started: @wlApp.Constants.AppStartedOn &bull;
        culture: @CultureInfo.CurrentCulture.TwoLetterISOLanguageName @CultureInfo.CurrentCulture.DisplayName @CultureInfo.CurrentUICulture.NumberFormat.CurrencySymbol

    </div>

        
    <a class="btn btn-primary btn-sm" href="/admin/reloadapp">Reload IIS Application</a>
</div>